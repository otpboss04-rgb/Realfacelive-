const $=id=>document.getElementById(id);let mode="register",token=localStorage.getItem("rfl_token")||"";
function view(name){["landing","auth","dashboard"].forEach(id=>$(id).classList.toggle("hidden",id!==name));$("topLogin").classList.toggle("hidden",name==="dashboard"||(name==="auth"&&mode==="login"));window.scrollTo({top:0,behavior:"smooth"});}
function setMode(next){mode=next;$("authTitle").textContent=mode==="register"?"Create your account":"Welcome back";$("authSubtitle").textContent=mode==="register"?"Your creative workspace is a few steps away.":"Log in to continue to your workspace.";$("nameWrap").classList.toggle("hidden",mode==="login");$("name").required=mode==="register";$("password").autocomplete=mode==="register"?"new-password":"current-password";$("authSubmit").textContent=mode==="register"?"Create account":"Log in";$("switchText").innerHTML=mode==="register"?'Already registered? <button id="switchAuth" class="link">Log in</button>':'New to RealFace Live? <button id="switchAuth" class="link">Create account</button>';$("switchAuth").onclick=()=>setMode(mode==="register"?"login":"register");$("authError").textContent="";view("auth");}
async function api(path,options={}){const headers=options.headers||{};if(token)headers.Authorization="Bearer "+token;const res=await fetch(path,{...options,headers});const data=await res.json().catch(()=>({}));if(!res.ok)throw new Error(data.error||"Request failed.");return data;}
function enter(user){$("userName").textContent=(user.name||"creator").split(" ")[0];view("dashboard");}
$("heroRegister").onclick=()=>setMode("register");$("heroLogin").onclick=()=>setMode("login");$("topLogin").onclick=()=>setMode("login");$("backHome").onclick=()=>view("landing");
$("authForm").onsubmit=async e=>{e.preventDefault();$("authError").textContent="";$("authSubmit").disabled=true;$("authSubmit").textContent="Please wait…";try{const p=mode==="register"?"/api/register":"/api/login";const d=await api(p,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:$("name").value.trim(),email:$("email").value.trim(),password:$("password").value})});token=d.token;localStorage.setItem("rfl_token",token);enter(d.user);}catch(err){$("authError").textContent=err.message;}finally{$("authSubmit").disabled=false;$("authSubmit").textContent=mode==="register"?"Create account":"Log in";}};
$("logout").onclick=()=>{token="";localStorage.removeItem("rfl_token");view("landing");};
async function restore(){if(!token)return;try{const d=await api("/api/me",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});enter(d.user);}catch{token="";localStorage.removeItem("rfl_token");}}restore();
$("swapForm").onsubmit=async e=>{e.preventDefault();$("swapError").textContent="";$("result").classList.add("hidden");const target=$("targetImage").files[0],source=$("sourceImage").files[0];if(!target||!source)return;if(target.size>4*1024*1024||source.size>4*1024*1024){$("swapError").textContent="Each image must be 4 MB or smaller.";return;}if(!$("consent").checked){$("swapError").textContent="Please confirm you have permission to use both images.";return;}const button=$("swapButton");button.disabled=true;button.textContent="Submitting to AI…";try{const fd=new FormData();fd.append("targetImage",target);fd.append("sourceImage",source);let d=await api("/api/faceswap",{method:"POST",body:fd});let output=d.output;let status=d.status;const id=d.predictionId;for(let i=0;i<36&&(!output||status==="starting"||status==="processing");i++){button.textContent=`Processing image… (${i+1})`;await new Promise(r=>setTimeout(r,2500));d=await api("/api/face-status",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})});status=d.status;output=d.output;if(status==="failed"||status==="canceled")throw new Error(d.error||"AI processing failed.");}if(!output)throw new Error("The AI job is taking longer than expected. Try again shortly.");const resultUrl=Array.isArray(output)?output[0]:(typeof output==="string"?output:(output.url||output.image));if(!resultUrl)throw new Error("The AI job finished but returned no image URL.");$("resultImage").src=resultUrl;$("downloadResult").href=resultUrl;$("result").classList.remove("hidden");$("result").scrollIntoView({behavior:"smooth",block:"start"});}catch(err){$("swapError").textContent=err.message;}finally{button.disabled=false;button.textContent="Swap faces";}};
